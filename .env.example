# Copy this file to ".env" for local development and fill in your own values.
# NEVER commit the real .env file. It is listed in .gitignore.
# On Vercel, add the same two variables in Project → Settings → Environment Variables.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → "Publishable key" (or legacy "anon" key)
SUPABASE_ANON_KEY=your-publishable-or-anon-key
